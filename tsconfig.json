{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "pdd-toolkit/report/selectors": ["./src/report-selectors.ts"],
      "pdd-toolkit/report/compare": ["./src/report-compare.ts"],
      "pdd-toolkit/report": ["./src/report.ts"]
    },
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test/**/*.ts", "tsdown.config.ts"]
}
