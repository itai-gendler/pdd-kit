{
  "name": "pdd-kit-site",
  "private": true,
  "type": "module",
  "description": "The pdd-kit.dev site: docs, blog, changelog, FAQ and Blueprints, generated as static files.",
  "scripts": {
    "blueprints": "node scripts/prepare-blueprints.mjs",
    "dev": "pnpm blueprints && nuxt dev",
    "generate": "pnpm blueprints && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "editorconfig": "EC_VERSION=v3.11.3 editorconfig-checker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm typecheck:nuxt && pnpm typecheck:tooling",
    "typecheck:nuxt": "PDD_KIT_NUXT_BUILD_DIR=.nuxt-typecheck nuxt prepare && vue-tsc -b tsconfig.typecheck.json --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "knip": "knip",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "test": "pnpm test:integration && pnpm test:e2e",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@comark/vue": "^0.8.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.149",
    "pdd-toolkit": "workspace:*",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "elkjs": "^0.12.1",
    "h3": "^1.15.11",
    "hast-util-to-html": "^9.0.6",
    "motion-v": "^2.9.0",
    "nuxt": "4.4.8",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/logos": "^1.2.18",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "editorconfig-checker": "^7.0.0",
    "eslint": "^10.14.0",
    "fast-xml-parser": "^5.11.2",
    "knip": "^6.44.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
