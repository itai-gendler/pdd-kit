{
  "name": "pdd-toolkit",
  "version": "0.37.1",
  "description": "Product-Driven Development for coding agents: a git-tracked Product Model in product-model/, verified against implementation.",
  "keywords": [
    "product-driven-development",
    "pdd",
    "product-model",
    "coding-agents",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "codex",
    "specification",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itai-gendler/pdd-kit.git"
  },
  "homepage": "https://pdd-kit.dev",
  "bugs": {
    "url": "https://github.com/itai-gendler/pdd-kit/issues"
  },
  "packageManager": "pnpm@12.11.2",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pdd-kit": "dist/cli.js"
  },
  "exports": {
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./report/digest": {
      "types": "./dist/report-digest.d.ts",
      "default": "./dist/report-digest.js"
    },
    "./report/compare": {
      "types": "./dist/report-compare.d.ts",
      "default": "./dist/report-compare.js"
    },
    "./report/selectors": {
      "types": "./dist/report-selectors.d.ts",
      "default": "./dist/report-selectors.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "default": "./dist/logo.js"
    },
    "./nuxt/report-viewer": "./layers/nuxt/report-viewer/nuxt.config.ts",
    "./nuxt/theme": "./layers/nuxt/theme/nuxt.config.ts",
    "./nuxt/theme-lab": "./layers/nuxt/theme-lab/nuxt.config.ts",
    "./theme-lab/variants": {
      "types": "./dist/pddKitThemeLabVariants.d.ts",
      "default": "./dist/pddKitThemeLabVariants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "!docs/images",
    "layers",
    "!layers/nuxt/report-viewer-lab",
    "!layers/**/node_modules",
    "skills"
  ],
  "scripts": {
    "build": "pnpm build:core && pnpm build:viewer",
    "build:core": "tsdown",
    "build:viewer": "pnpm --filter @pdd-kit/local-report-viewer build && node scripts/copy-viewer.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:unlink": "node scripts/dev.mjs --unlink",
    "view:fixture": "node scripts/view-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:viewer": "pnpm --filter @pdd-kit/local-report-viewer typecheck",
    "test": "vitest run",
    "package:size": "node scripts/check-package-size.mjs",
    "theme:icons": "node scripts/build-theme-icons.mjs",
    "vocabulary": "node scripts/build-vocabulary.mjs",
    "blueprints:check": "node scripts/blueprints-check.mjs",
    "blueprints:release": "node scripts/blueprints-release.mjs",
    "check": "node scripts/check-repo.mjs",
    "changelog:release": "node scripts/changelog-release.mjs",
    "check:consumer": "node scripts/check-nuxt-consumer.mjs",
    "verify": "pnpm typecheck && pnpm typecheck:viewer && pnpm build && pnpm package:size && pnpm check:consumer && pnpm test && pnpm check && pnpm blueprints:check",
    "version": "node scripts/sync-version.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "comark": "^0.7.0",
    "commander": "^15.0.0",
    "saxes": "^6.0.0",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@comark/vue": "^0.7.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/ui": "^4.9.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "elkjs": "^0.12.0",
    "nuxt": "^4.4.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@fontsource-variable/archivo": {
      "optional": true
    },
    "@fontsource-variable/inter": {
      "optional": true
    },
    "@fontsource/ibm-plex-mono": {
      "optional": true
    },
    "@iconify-json/lucide": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    },
    "@vue-flow/background": {
      "optional": true
    },
    "@vue-flow/core": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@comark/vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "lefthook": "^2.2.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
